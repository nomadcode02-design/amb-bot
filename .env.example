# Puerto HTTP (Railway suele inyectarlo automáticamente)
PORT=3000

# Credenciales de WhatsApp Cloud API (configurar en Railway, nunca subir valores reales)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WEBHOOK_VERIFY_TOKEN=
# Secreto aleatorio largo para proteger el panel y sus endpoints
PANEL_KEY=

# Número del dueño para avisos, opcional. Formato internacional sin + ni espacios.
OWNER_WHATSAPP=

# Ruta persistente de datos. En Railway debe apuntar al volumen montado.
DATA_DIR=

# Contacto humano que aparece en los mensajes automáticos
TELEFONO_CONTACTO=

# Seguridad: los recordatorios permanecen apagados salvo activación explícita.
# Para activarlos, establecer true solo después de validar consentimiento y plantillas.
RECORDATORIOS_ACTIVOS=false
MAX_INTENTOS_RECORDATORIO=2
