# Número de WhatsApp del dueño para recibir aviso de cada reserva (opcional)
# Formato: código de área + número, sin 0 ni 15. Ej: 2646023107
OWNER_WHATSAPP=

# Token de verificación del webhook (debe coincidir con el configurado en Meta)
WEBHOOK_VERIFY_TOKEN=

# App Secret de Meta: necesario para verificar X-Hub-Signature-256.
# Obtenelo en Meta App Dashboard > App settings > Basic y guardalo como secreto.
META_APP_SECRET=

PORT=3000
