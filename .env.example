# Configuración del bot AMB BARBERS para Railway.
# No copies secretos reales a este archivo ni al repositorio.

PORT=3000

# Credenciales oficiales de WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v26.0
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Clave larga y única para el panel administrativo (mínimo 32 caracteres).
PANEL_KEY=

# Número del dueño para avisos internos (opcional, formato internacional).
OWNER_WHATSAPP=
TELEFONO_CONTACTO=+54 9 2643 21-2176

# Seguridad: los envíos y recordatorios quedan apagados hasta habilitarlos
# expresamente después de verificar la cuenta y las credenciales en Meta.
WHATSAPP_ENVIOS_ACTIVOS=false
RECORDATORIOS_ACTIVOS=false
